{
  "id": "nl.brokebyte.juraconnect",
  "version": "0.2.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "name": {
    "en": "Jura Connect",
    "nl": "Jura Connect"
  },
  "description": {
    "en": "Control a Jura coffee machine fitted with the WiFi Connect module — local, no cloud. Ships with profiles for 72 Jura models; only the E8 (EF538) is live-verified so far, see the README.",
    "nl": "Bedien een Jura-koffiemachine met de WiFi Connect-module — lokaal, geen cloud. Wordt geleverd met profielen voor 72 Jura-modellen; alleen de E8 (EF538) is tot nu toe live geverifieerd, zie de README."
  },
  "category": [
    "appliances"
  ],
  "permissions": [],
  "brandColor": "#4B3621",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "author": {
    "name": "Wout"
  },
  "capabilities": {
    "jura_maintenance_cleaning": {
      "type": "number",
      "title": {
        "en": "Cleaning",
        "nl": "Reiniging"
      },
      "units": {
        "en": "%",
        "nl": "%"
      },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "jura_maintenance_filter": {
      "type": "number",
      "title": {
        "en": "Filter",
        "nl": "Filter"
      },
      "units": {
        "en": "%",
        "nl": "%"
      },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "jura_maintenance_descale": {
      "type": "number",
      "title": {
        "en": "Descale",
        "nl": "Ontkalken"
      },
      "units": {
        "en": "%",
        "nl": "%"
      },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    }
  },
