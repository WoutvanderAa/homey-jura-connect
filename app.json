{
  "id": "nl.brokebyte.juraconnect",
  "version": "0.2.1",
  "compatibility": ">=5.0.0",
  "platforms": [
    "local"
  ],
  "sdk": 3,
  "name": {
    "en": "Jura Connect",
    "nl": "Jura Connect"
  },
  "description": {
    "en": "Control a Jura coffee machine fitted with the WiFi Connect module — local, no cloud. Ships with profiles for 72 Jura models; only the E8 (EF538) is live-verified so far, see the README.",
    "nl": "Bedien een Jura-koffiemachine met de WiFi Connect-module — lokaal, geen cloud. Wordt geleverd met profielen voor 72 Jura-modellen; alleen de E8 (EF538) is tot nu toe live geverifieerd, zie de README."
  },
  "category": [
    "appliances"
  ],
  "permissions": [],
  "brandColor": "#4B3621",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "author": {
    "name": "Wout",
    "email": "[redacted-email]"
  },
  "support": "https://github.com/WoutvanderAa/homey-jura-connect/issues",
  "bugs": {
    "url": "https://github.com/WoutvanderAa/homey-jura-connect/issues"
  },
  "source": "https://github.com/WoutvanderAa/homey-jura-connect",
  "capabilities": {
    "jura_maintenance_cleaning": {
      "type": "number",
      "title": {
        "en": "Cleaning due",
        "nl": "Reiniging nodig"
      },
      "desc": {
        "en": "Percent towards the next cleaning cycle being due — higher means more due, drops back to 0% right after cleaning runs.",
        "nl": "Percentage richting de volgende reinigingsbeurt — hoger betekent meer nodig, valt terug naar 0% direct na het reinigen."
      },
      "units": {
        "en": "%",
        "nl": "%"
      },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "jura_maintenance_filter": {
      "type": "number",
      "title": {
        "en": "Filter due",
        "nl": "Filter nodig"
      },
      "desc": {
        "en": "Percent towards the water filter cartridge needing replacement — higher means more due. Not shown if the machine has no filter cartridge fitted.",
        "nl": "Percentage richting vervanging van de waterfilter-cartridge — hoger betekent meer nodig. Wordt niet getoond als de machine geen filtercartridge heeft."
      },
      "units": {
        "en": "%",
        "nl": "%"
      },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "jura_maintenance_descale": {
      "type": "number",
      "title": {
        "en": "Descale due",
        "nl": "Ontkalken nodig"
      },
      "desc": {
        "en": "Percent towards descaling being due — higher means more due, drops back to 0% right after descaling runs.",
        "nl": "Percentage richting ontkalken — hoger betekent meer nodig, valt terug naar 0% direct na het ontkalken."
      },
      "units": {
        "en": "%",
        "nl": "%"
      },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    }
  },
  "drivers": [
    {
      "id": "jura-machine",
      "name": {
        "en": "Jura Coffee Machine",
        "nl": "Jura Koffiemachine"
      },
